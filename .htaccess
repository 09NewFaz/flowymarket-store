# Generado por scripts/build.mjs — Apache / LiteSpeed (Hostinger).
# GitHub Pages ignora este archivo; ahí rigen la CSP en <meta> y js/frame-guard.js.
Options -Indexes
DirectoryIndex index.html
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www → dominio sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Bloquear archivos ocultos (.env, .git, etc.)
  RewriteRule (^|/)\. - [F,L]
  # El panel ya no vive en la tienda: rutas antiguas → subdominio del panel
  RewriteRule ^(admin|admin\.html|dashboard\.html)(/.*)?$ https://admin.flowymarket.site/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://dvkxpkxvknfxyefoqlfp.supabase.co; connect-src https://dvkxpkxvknfxyefoqlfp.supabase.co wss://dvkxpkxvknfxyefoqlfp.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header unset X-Powered-By

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
</IfModule>
